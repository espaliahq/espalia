// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ruby
{
  "name": "growth_os (${localWorkspaceFolderBasename})",
  "dockerComposeFile": "compose.yaml",
  "service": "rails-app",
  "initializeCommand": ".devcontainer/initialize.sh",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    // CodeRabbit CLI auth is a plain file (~/.coderabbit/auth.json); sharing
    // the directory means one login works on host and container alike and
    // survives rebuilds. The dir also holds the CLI's logs and stats, so a
    // host-side and a container-side review share that mutable state too.
    // initialize.sh creates the dir so the mount works on a fresh host.
    "source=${localEnv:HOME}/.coderabbit,target=/home/vscode/.coderabbit,type=bind"
  ],
  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Authenticates gh from the HOST's GitHub credential on every attach, via the
    // git credential helper the Dev Containers extension already forwards. The
    // github-cli feature above installs the binary only — it forwards no
    // credentials — and gh never reads git's credential helper for its own auth,
    // so without this the container needs a `gh auth login` of its own: a
    // point-in-time credential that shadows the delegation and then rots.
    "ghcr.io/redbeard/devcontainer-features/gh-auth-from-host:1": {},
    "ghcr.io/rails/devcontainer/features/activestorage": {},
    "ghcr.io/rails/devcontainer/features/postgres-client": {},
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "remoteEnv": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "${localEnv:CLAUDE_CODE_ENABLE_TELEMETRY}",
    "CLAUDE_CODE_OAUTH_401_WAIT_MS": "${localEnv:CLAUDE_CODE_OAUTH_401_WAIT_MS}",
    "OTEL_METRICS_EXPORTER": "${localEnv:OTEL_METRICS_EXPORTER}",
    "OTEL_LOGS_EXPORTER": "${localEnv:OTEL_LOGS_EXPORTER}",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "${localEnv:OTEL_EXPORTER_OTLP_PROTOCOL}",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "${localEnv:OTEL_EXPORTER_OTLP_ENDPOINT}",
    "OTEL_METRIC_EXPORT_INTERVAL": "${localEnv:OTEL_METRIC_EXPORT_INTERVAL}",
    "OTEL_EXPORTER_OTLP_HEADERS": "${localEnv:OTEL_EXPORTER_OTLP_HEADERS}"
  },
  "containerEnv": {
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    // postCreateCommand installs the claude CLI here, so an absent binary is a
    // broken install: make the MCP parity test flunk instead of skipping.
    "REQUIRE_MCP_CLI": "1",
    // Rails' `server` command defaults to 3000 regardless of config/puma.rb, so
    // set PORT to keep a bare `bin/rails server` on the same port bin/dev uses.
    // 6600 avoids clashing with other apps devs run on the host.
    "PORT": "6600"
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [
    6600,
    5432
  ],
  "portsAttributes": {
    "6600": { "label": "Rails", "onAutoForward": "notify" },
    "5432": { "label": "Postgres", "onAutoForward": "silent" }
  },
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "CodeRabbit.coderabbit-vscode"
      ]
    }
  },
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root",
  // Use 'postCreateCommand' to run commands after the container is created.
  // Both lifecycle hooks run failure-tolerant step scripts: every independent
  // step runs even when an earlier one fails (a bin/setup or db:prepare
  // failure previously skipped the claude CLI install / chrome CDP proxy),
  // and the script still exits non-zero so the failure stays visible.
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": ".devcontainer/post-start.sh"
}