{
  "name": "frameworks_archive_capability",
  "description": "Archive a capability — applied directly with approval rights in editing mode, else proposed as a suggestion. A supplied migration mapping is staged only if you may define one (owner/editor); the response's mapping_recorded says whether it was, otherwise it is deferred to the publish-review gate.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "framework_id": {
        "type": "string"
      },
      "capability_id": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      },
      "mapping_type": {
        "type": "string",
        "enum": [
          "same",
          "evolved",
          "split",
          "archived",
          "new"
        ]
      },
      "to_stable_id": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": [
          "editing",
          "suggesting"
        ]
      }
    },
    "required": [
      "framework_id",
      "capability_id"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "mapping_type": {
              "enum": [
                "evolved",
                "split"
              ]
            }
          },
          "required": [
            "mapping_type"
          ]
        },
        "then": {
          "required": [
            "to_stable_id"
          ],
          "properties": {
            "to_stable_id": {
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "mapping_type": {
              "enum": [
                "same",
                "archived",
                "new"
              ]
            }
          },
          "required": [
            "mapping_type"
          ]
        },
        "then": {
          "not": {
            "required": [
              "to_stable_id"
            ]
          }
        }
      },
      {
        "dependentRequired": {
          "to_stable_id": [
            "mapping_type"
          ]
        }
      }
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false
  },
  "approval": "mcp_client"
}
