{
  "name": "assessments_rate_self",
  "description": "Record or update your own rating for one capability × level. Pass as_role_id to rate a cell another role in the framework reads (a role lens): the rating is the same fact about you at that capability × level, and counts wherever a role reads the cell.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "assignment_id": {
        "type": "string"
      },
      "capability_stable_id": {
        "type": "string"
      },
      "level_ordinal": {
        "type": "integer"
      },
      "frequency": {
        "type": "string",
        "enum": [
          "none",
          "some",
          "occasional",
          "consistent"
        ]
      },
      "comment": {
        "type": "string"
      },
      "rationale": {
        "type": "string"
      },
      "clear": {
        "type": "boolean"
      },
      "confirm": {
        "type": "boolean"
      },
      "as_role_id": {
        "type": "string"
      }
    },
    "required": [
      "assignment_id",
      "capability_stable_id",
      "level_ordinal",
      "frequency"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false
  },
  "approval": "mcp_client"
}
