{
  "name": "frameworks_define_migration_mapping",
  "description": "Define or edit a capability migration mapping for the current draft (owner/editor only).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "framework_id": {
        "type": "string"
      },
      "from_stable_id": {
        "type": "string"
      },
      "mapping_type": {
        "type": "string",
        "enum": [
          "same",
          "evolved",
          "split",
          "archived",
          "new"
        ]
      },
      "to_stable_id": {
        "type": "string"
      },
      "mapping_id": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "framework_id",
      "from_stable_id",
      "mapping_type"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "mapping_type": {
              "enum": [
                "evolved",
                "split"
              ]
            }
          },
          "required": [
            "mapping_type"
          ]
        },
        "then": {
          "required": [
            "to_stable_id"
          ],
          "properties": {
            "to_stable_id": {
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "mapping_type": {
              "enum": [
                "same",
                "archived",
                "new"
              ]
            }
          },
          "required": [
            "mapping_type"
          ]
        },
        "then": {
          "not": {
            "required": [
              "to_stable_id"
            ]
          }
        }
      }
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false
  }
}
