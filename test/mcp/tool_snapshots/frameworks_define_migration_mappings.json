{
  "name": "frameworks_define_migration_mappings",
  "description": "Save migration mappings for several retiring capabilities in one atomic write; unchanged rows are skipped and rows still needing a survivor are reported (owner/editor only).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "framework_id": {
        "type": "string"
      },
      "mappings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from_stable_id": {
              "type": "string"
            },
            "mapping_type": {
              "type": "string",
              "enum": [
                "same",
                "evolved",
                "split",
                "archived",
                "new"
              ]
            },
            "to_stable_id": {
              "type": "string"
            },
            "mapping_id": {
              "type": "string"
            }
          },
          "required": [
            "from_stable_id"
          ]
        }
      }
    },
    "required": [
      "framework_id",
      "mappings"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false
  }
}
