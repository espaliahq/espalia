{
  "name": "calibration_sessions_rename",
  "description": "Rename a calibration session (any status; the session log records the previous name).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "required": [
      "session_id",
      "name"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false
  },
  "approval": "mcp_client"
}
