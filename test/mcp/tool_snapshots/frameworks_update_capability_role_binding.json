    "properties": {
      "framework_id": {
        "type": "string"
      },
      "binding_id": {
        "type": "string"
      },
      "weight": {
        "type": "number"
      },
      "individual_tolerance": {
        "type": "number"
      }
    },
    "required": [
      "framework_id",
      "binding_id"
    ],
    "additionalProperties": false,
    "anyOf": [
      {
        "required": [
          "weight"
        ]
      },
      {
        "required": [
          "individual_tolerance"
        ]
      }
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false
  },
  "approval": "mcp_client"
}
