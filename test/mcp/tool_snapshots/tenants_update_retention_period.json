{
  "name": "tenants_update_retention_period",
  "description": "Set how many years after a person leaves the active tenant forgets their identifiers (default 7), or never forget them.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "retention_years": {
        "type": "integer"
      },
      "never": {
        "type": "boolean"
      }
    },
    "required": [],
    "additionalProperties": false,
    "if": {
      "properties": {
        "never": {
          "const": true
        }
      },
      "required": [
        "never"
      ]
    },
    "then": {
      "not": {
        "required": [
          "retention_years"
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false
  },
  "approval": "in_app"
}
