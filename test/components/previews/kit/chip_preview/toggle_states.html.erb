<div class="space-y-4">
  <% [ [ "On a card", "bg-default border border-default rounded-2xl p-4" ], [ "On the page", "py-4" ] ].each do |title, surface| %>
    <div class="<%= surface %>">
      <p class="mb-3 text-xs font-medium text-muted"><%= title %></p>
      <div class="flex flex-wrap items-center gap-2">
        <%= render Components::Kit::Chip.new("Rest") %>
        <%= render Components::Kit::Chip.new("Selected", pressed: true) %>
        <%= render Components::Kit::Chip.new("With icon", leading_icon: "plus") %>
        <%= render Components::Kit::Chip.new("Disabled", disabled: true) %>
        <%= render Components::Kit::Chip.new("Selected, disabled", pressed: true, disabled: true) %>
      </div>
    </div>
  <% end %>
</div>
