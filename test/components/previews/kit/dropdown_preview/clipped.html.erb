<div class="flex items-center justify-between max-w-md overflow-hidden rounded-lg border border-default bg-default px-4">
  <span class="text-sm font-semibold">Engineering calibration, March</span>
  <%= render Components::Kit::Dropdown.new(align: :right, strategy: strategy) do |dropdown| %>
    <% dropdown.trigger(label: "Actions for Engineering calibration, March",
                        button: { variant: :ghost, icon: true, touch: true }) do %>
      <svg class="size-4" aria-hidden="true" focusable="false"><use href="#icon-kebab"></use></svg>
    <% end %>
    <% dropdown.menu(width: "w-44") do %>
      <% dropdown.item(href: "#") { "Open" } %>
      <% dropdown.item(data: { action: "dropdown#close" }) { "Rename…" } %>
      <% dropdown.item(data: { action: "dropdown#close" }) { "Archive" } %>
    <% end %>
  <% end %>
</div>
