<div class="flex <%= align == :right ? "justify-end" : "" %> max-w-md">
  <%= render Components::Kit::Dropdown.new(align: align, strategy: strategy) do |dropdown| %>
    <% dropdown.trigger(label: "Comment actions", button: { variant: :ghost, size: :xs, icon: true }) do %>
      <svg class="size-4" aria-hidden="true" focusable="false"><use href="#icon-kebab"></use></svg>
    <% end %>
    <% dropdown.menu(width: "w-32") do %>
      <% dropdown.item(size: :xs, data: { action: "dropdown#close" }) { "Reply" } %>
      <% dropdown.item(size: :xs, data: { action: "dropdown#close" }) { "Edit" } %>
      <% dropdown.item(tone: :danger, size: :xs, data: { action: "dropdown#close" }) { "Delete" } %>
    <% end %>
  <% end %>
</div>
