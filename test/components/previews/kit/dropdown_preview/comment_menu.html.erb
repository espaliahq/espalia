<% item = "block w-full text-left px-3 py-1.5 text-xs text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700" %>
<div class="flex <%= align == :right ? "justify-end" : "" %> max-w-md">
  <%= render Components::Kit::Dropdown.new(align: align, strategy: strategy) do |dropdown| %>
    <% dropdown.trigger(label: "Comment actions") do %>
      <span class="inline-flex h-11 w-11 items-center justify-center rounded-md text-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700" aria-hidden="true">⋮</span>
    <% end %>
    <% dropdown.menu(width: "w-32") do %>
      <button type="button" role="menuitem" class="<%= item %>" data-action="dropdown#close">Reply</button>
      <button type="button" role="menuitem" class="<%= item %>" data-action="dropdown#close">Edit</button>
      <button type="button" role="menuitem" class="block w-full text-left px-3 py-1.5 text-xs text-red-700 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-900/30" data-action="dropdown#close">Delete</button>
    <% end %>
  <% end %>
</div>
