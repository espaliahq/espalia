<div class="space-y-4">
  <% [ [ "On a card", "bg-default border border-default rounded-2xl p-4" ], [ "On the page", "py-4" ] ].each do |title, surface| %>
    <div class="<%= surface %>">
      <p class="mb-3 text-xs font-medium text-muted"><%= title %></p>
      <div class="flex flex-wrap items-center gap-3">
        <% tones.each do |tone| %>
          <%= render Components::Kit::Button.new(variant: form, tone: tone) { tone.to_s.capitalize } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
