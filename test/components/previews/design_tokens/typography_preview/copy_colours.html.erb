<section class="max-w-4xl">
  <h2 class="text-lg font-semibold text-default">Copy colours</h2>
  <ul class="mt-4 divide-y divide-default">
    <% colours.each do |css_class, sentence| %>
      <li class="py-3">
        <p class="font-mono text-xs text-muted"><%= css_class %></p>
        <p class="<%= css_class %> mt-1 text-base"><%= sentence %></p>
      </li>
    <% end %>
  </ul>
</section>
