<section class="max-w-4xl">
  <h2 class="text-lg font-semibold text-gray-900 dark:text-white"><%= title %></h2>
  <ul class="mt-4 divide-y divide-gray-200 dark:divide-gray-800">
    <% classes.each do |css_class| %>
      <li class="py-3" data-type-sample>
        <p class="font-mono text-xs text-gray-600 dark:text-gray-300">
          <%= css_class %><% if measure %> · <span data-metrics>—</span><% end %>
        </p>
        <p class="<%= css_class %> mt-1 text-gray-900 dark:text-white" data-sample><%= sample %></p>
      </li>
    <% end %>
  </ul>
</section>
<% if measure %>
  <script>
    document.querySelectorAll("[data-type-sample]").forEach((item) => {
      const style = getComputedStyle(item.querySelector("[data-sample]"))
      item.querySelector("[data-metrics]").textContent = `${style.fontSize} / ${style.lineHeight}`
    })
  </script>
<% end %>
