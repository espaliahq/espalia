<section class="max-w-4xl space-y-4">
  <h2 class="text-lg font-semibold text-default">Font family</h2>
  <dl class="space-y-3 text-sm">
    <div>
      <dt class="text-muted"><code>--font-sans</code> in <code>app/assets/tailwind/application.css</code></dt>
      <dd class="mt-1 font-mono text-xs text-default"><%= declared %></dd>
    </div>
    <div>
      <dt class="text-muted">Computed on <code>body</code></dt>
      <dd class="mt-1 font-mono text-xs text-default" data-computed-family>—</dd>
    </div>
  </dl>
  <p class="text-2xl text-default"><%= sample %></p>
  <p class="text-2xl text-default">0123456789 · AaBbCcDdEeFfGg · → ✓</p>
</section>
<script>
  document.querySelector("[data-computed-family]").textContent = getComputedStyle(document.body).fontFamily
</script>
