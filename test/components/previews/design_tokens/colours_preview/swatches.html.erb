<% if scoped_css %>
  <style><%= scoped_css.html_safe %></style>
<% end %>
<section class="<%= scope_class %> max-w-4xl" data-token-swatches>
  <h2 class="text-lg font-semibold text-gray-900 dark:text-white"><%= title %></h2>
  <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">
    Read from <code>app/assets/tailwind/application.css</code>. Values follow the browser's colour scheme.
  </p>
  <table class="mt-4 w-full text-sm">
    <thead>
      <tr class="text-left text-xs text-gray-600 dark:text-gray-300">
        <th class="py-2 pr-4 font-medium">Swatch</th>
        <th class="py-2 pr-4 font-medium">Token</th>
        <th class="py-2 pr-4 font-medium">Resolved</th>
        <th class="py-2 pr-4 font-medium">On #ffffff</th>
        <th class="py-2 font-medium">On #030712</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
      <% tokens.each do |token| %>
        <tr data-token="<%= token %>">
          <td class="py-2 pr-4">
            <span data-swatch class="block size-10 rounded-md ring-1 ring-gray-300 dark:ring-gray-700" style="background-color: var(<%= token %>)"></span>
          </td>
          <td class="py-2 pr-4 font-mono text-gray-900 dark:text-white"><%= token %></td>
          <td class="py-2 pr-4 font-mono text-xs text-gray-600 dark:text-gray-300">
            <span data-resolved>—</span>
            <span data-declared class="block text-gray-500 dark:text-gray-400"></span>
          </td>
          <td class="py-2 pr-4 font-mono" data-contrast="#ffffff">—</td>
          <td class="py-2 font-mono" data-contrast="#030712">—</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
<script>
  (() => {
    const canvas = document.createElement("canvas")
    canvas.width = canvas.height = 1
    const context = canvas.getContext("2d", { willReadFrequently: true })

    const toRgb = (colour) => {
      context.clearRect(0, 0, 1, 1)
      context.fillStyle = colour
      context.fillRect(0, 0, 1, 1)
      return Array.from(context.getImageData(0, 0, 1, 1).data)
    }
    const luminance = ([r, g, b]) => {
      const channel = (v) => {
        const s = v / 255
        return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4
      }
      return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b)
    }
    const contrast = (a, b) => {
      const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x)
      return (hi + 0.05) / (lo + 0.05)
    }
    const hex = ([r, g, b]) => "#" + [r, g, b].map((v) => v.toString(16).padStart(2, "0")).join("")

    const paint = () => {
      document.querySelectorAll("[data-token-swatches] [data-token]").forEach((row) => {
        const token = row.dataset.token
        const swatch = row.querySelector("[data-swatch]")
        const resolved = getComputedStyle(swatch).backgroundColor
        const rgba = toRgb(resolved)
        row.querySelector("[data-declared]").textContent = getComputedStyle(swatch).getPropertyValue(token).trim()
        row.querySelector("[data-resolved]").textContent = rgba[3] < 255 ? resolved : hex(rgba)
        row.querySelectorAll("[data-contrast]").forEach((cell) => {
          const ratio = contrast(rgba, toRgb(cell.dataset.contrast))
          cell.textContent = ratio.toFixed(2) + ":1" + (ratio >= 4.5 ? " AA" : ratio >= 3 ? " AA large" : "")
        })
      })
    }

    paint()
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", paint)
  })()
</script>
