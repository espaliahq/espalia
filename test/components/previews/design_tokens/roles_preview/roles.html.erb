<%= render "design_tokens/contrast_script" %>
<section class="max-w-5xl space-y-8" data-role-swatches>
  <div>
    <h2 class="text-lg font-semibold text-default">Colour roles</h2>
    <p class="mt-1 text-sm text-muted">
      Read from <code>app/assets/tailwind/theme/roles.css</code>. Contrast is measured as painted:
      text needs 4.5:1, borders and the focus ring 3:1.
    </p>
    <p class="mt-1 text-sm text-muted" data-scheme-readout></p>
  </div>

  <% groups.each do |group, roles| %>
    <div>
      <h3 class="text-sm font-semibold text-default"><%= group %></h3>
      <table class="mt-2 w-full text-sm">
        <thead>
          <tr class="border-b border-default text-left text-xs text-muted">
            <th class="py-2 pr-4 font-medium">Swatch</th>
            <th class="py-2 pr-4 font-medium">Role</th>
            <th class="py-2 pr-4 font-medium">Utilities</th>
            <th class="py-2 pr-4 font-medium">Value</th>
            <th class="py-2 font-medium">Contrast</th>
          </tr>
        </thead>
        <tbody>
          <% roles.each do |role| %>
            <tr class="border-b border-subtle align-top" data-role="<%= role[:name] %>">
              <td class="py-2 pr-4">
                <span class="block size-10 rounded-md border border-default" style="background-color: var(<%= role[:name] %>)"></span>
              </td>
              <td class="py-2 pr-4 font-mono text-xs text-default"><%= role[:name].delete_prefix("--gos-") %></td>
              <td class="py-2 pr-4 font-mono text-xs text-default">
                <% role[:utilities].each do |utility| %>
                  <span class="block"><%= utility %></span>
                <% end %>
              </td>
              <td class="py-2 pr-4 font-mono text-xs text-muted">
                <span class="block text-default" data-resolved>—</span>
                <span class="block max-w-xs break-words" data-declared></span>
              </td>
              <td class="py-2 font-mono text-xs">
                <% role[:checks].each do |text, fill, minimum| %>
                  <span class="block" data-check data-text="<%= text %>" data-fill="<%= fill %>" data-minimum="<%= minimum %>">
                    <span class="text-muted">
                      <%= text == role[:name] ? "on #{fill.delete_prefix("--gos-")}" : "#{text.delete_prefix("--gos-")} on it" %>
                    </span>
                    <span data-ratio>—</span>
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
<script>
  (() => {
    const { pixel, ratio, formatRatio, hex, resolve, dark, helperPath } = window.tokenContrast
    const section = document.querySelector("[data-role-swatches]")

    const paint = () => {
      section.querySelector("[data-scheme-readout]").textContent =
        `Rendering ${dark() ? "dark" : "light"}. Text on brand fills: ${helperPath()}.`

      section.querySelectorAll("[data-role]").forEach((row) => {
        const colour = resolve(row.dataset.role, section)
        const translucent = /rgba?\([^)]*,\s*0?\.\d+\)|\/\s*0?\.\d+\)/.test(colour)
        row.querySelector("[data-resolved]").textContent = translucent ? colour : hex(pixel(colour))
        row.querySelector("[data-declared]").textContent =
          getComputedStyle(section).getPropertyValue(row.dataset.role).trim()
      })

      section.querySelectorAll("[data-check]").forEach((check) => {
        const fill = pixel(resolve(check.dataset.fill, section))
        const text = pixel(resolve(check.dataset.text, section), fill)
        const value = ratio(text, fill)
        const minimum = Number(check.dataset.minimum)
        const cell = check.querySelector("[data-ratio]")
        cell.textContent = `${formatRatio(value)} ${value >= minimum ? "pass" : "fail"}`
        cell.className = value >= minimum ? "text-success" : "font-semibold text-danger"
        check.dataset.result = value >= minimum ? "pass" : "fail"
      })
    }

    paint()
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", paint)
  })()
</script>
