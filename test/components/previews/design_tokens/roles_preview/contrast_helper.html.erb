<%= render "design_tokens/contrast_script" %>
<%# Redeclares the helper as roles.css's fallback, so a browser with contrast-color() can show both paths. %>
<style>
  .helper-fallback [data-theme-scope] {
    --gos-brand-content-inverse: color(from var(--gos-brand-strong) srgb-linear
      clamp(0, (0.17913 - (0.2126 * r + 0.7152 * g + 0.0722 * b)) * 1e6, 1)
      clamp(0, (0.17913 - (0.2126 * r + 0.7152 * g + 0.0722 * b)) * 1e6, 1)
      clamp(0, (0.17913 - (0.2126 * r + 0.7152 * g + 0.0722 * b)) * 1e6, 1));
  }
</style>
<% columns = {
     "clamped" => ["Brand, as the theme derives its strong fill", ->(colour) { "--gos-brand: #{colour}" }],
     "direct" => ["The same colour as the strong fill", ->(colour) { "--gos-brand: #{colour}; --gos-brand-strong: #{colour}" }]
   } %>
<section class="max-w-5xl space-y-4" data-helper-proof>
  <div>
    <h2 class="text-lg font-semibold text-default">Text colour helper</h2>
    <p class="mt-1 text-sm text-muted">
      Each fill is a brand a tenant could pick, set inside its own theme scope. The text is the helper's pick:
      black or white, whichever reads better. It needs 4.5:1.
    </p>
    <p class="mt-1 text-sm text-default" data-path-readout></p>
    <label class="mt-3 inline-flex items-center gap-2 text-sm text-default">
      <input type="checkbox" data-force-fallback>
      Force the relative-colour fallback
    </label>
  </div>

  <div class="rounded-md border border-default bg-default p-3 text-sm text-default" data-agreement>—</div>

  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-default text-left text-xs text-muted">
        <th class="py-2 pr-4 font-medium">Brand</th>
        <% columns.each_value do |(label, _)| %>
          <th class="py-2 pr-4 font-medium"><%= label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% fills.each do |name, colour| %>
        <tr class="border-b border-subtle align-top">
          <td class="py-3 pr-4">
            <span class="block text-default"><%= name %></span>
            <span class="font-mono text-xs text-muted"><%= colour %></span>
          </td>
          <% columns.each do |key, (label, style)| %>
            <td class="py-3 pr-4" data-sample="<%= "#{name}, #{key}" %>">
              <div data-visible-sample>
                <div data-theme-scope style="<%= style.call(colour) %>">
                  <span class="tone-brand bg-tone-strong text-tone-content-inverse inline-block rounded-md px-3 py-2 font-medium" data-fill>
                    Save changes
                  </span>
                </div>
              </div>
              <span class="mt-1 block font-mono text-xs text-muted" data-readout>—</span>
              <%# The same scope by each path, to compare their picks. %>
              <div hidden>
                <div data-theme-scope style="<%= style.call(colour) %>">
                  <span class="tone-brand text-tone-content-inverse" data-probe="stylesheet"></span>
                </div>
                <div class="helper-fallback">
                  <div data-theme-scope style="<%= style.call(colour) %>">
                    <span class="tone-brand text-tone-content-inverse" data-probe="fallback"></span>
                  </div>
                </div>
              </div>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
<script>
  (() => {
    const { pixel, luminance, ratio, formatRatio, hex, ink, dark, helperPath } = window.tokenContrast
    const section = document.querySelector("[data-helper-proof]")
    const toggle = section.querySelector("[data-force-fallback]")
    const native = CSS.supports("color", "contrast-color(red)")

    const paint = () => {
      section.querySelectorAll("[data-visible-sample]").forEach((sample) => sample.classList.toggle("helper-fallback", toggle.checked))
      const path = toggle.checked ? "relative-colour fallback (forced)" : helperPath()
      section.querySelector("[data-path-readout]").textContent =
        `Rendering ${dark() ? "dark" : "light"}. Helper in use: ${path}.`

      const disagreements = []
      let failures = 0
      section.querySelectorAll("[data-sample]").forEach((cell) => {
        const sample = cell.querySelector("[data-fill]")
        const fill = pixel(getComputedStyle(sample).backgroundColor)
        const text = pixel(getComputedStyle(sample).color, fill)
        const value = ratio(text, fill)
        if (value < 4.5) failures++

        const stylesheetPick = ink(pixel(getComputedStyle(cell.querySelector('[data-probe="stylesheet"]')).color))
        const fallbackPick = ink(pixel(getComputedStyle(cell.querySelector('[data-probe="fallback"]')).color))
        if (stylesheetPick !== fallbackPick) {
          disagreements.push(`${cell.dataset.sample}: ${stylesheetPick} by contrast-color(), ${fallbackPick} by the fallback`)
        }

        const readout = cell.querySelector("[data-readout]")
        readout.textContent =
          `${hex(fill)} · luminance ${luminance(fill).toFixed(4)} · ${ink(text)} ${formatRatio(value)} ${value >= 4.5 ? "pass" : "fail"}`
        readout.className = `mt-1 block font-mono text-xs ${value >= 4.5 ? "text-muted" : "font-semibold text-danger"}`
        cell.dataset.result = value >= 4.5 ? "pass" : "fail"
        cell.dataset.agrees = stylesheetPick === fallbackPick
      })

      const box = section.querySelector("[data-agreement]")
      const total = section.querySelectorAll("[data-sample]").length
      const measured = failures ? `${failures} of ${total} fills fall below 4.5:1.` : `All ${total} fills reach 4.5:1.`
      if (!native) {
        box.textContent = `${measured} This browser has no contrast-color(), so both paths are the fallback and there is nothing to compare.`
      } else if (disagreements.length) {
        box.textContent = `${measured} The paths disagree on ${disagreements.length}: ${disagreements.join("; ")}.`
      } else {
        box.textContent = `${measured} contrast-color() and the fallback pick the same text on all ${total}.`
      }
      box.dataset.disagreements = disagreements.length
    }

    toggle.addEventListener("change", paint)
    paint()
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", paint)
  })()
</script>
