<section class="max-w-5xl space-y-6">
  <div>
    <h2 class="text-lg font-semibold text-default">Radius</h2>
    <p class="mt-1 text-sm text-muted">
      Tailwind's radius scale, not themed. Each Kit component owns one step, held by
      <code>test/lib/radius_shadow_steps_test.rb</code>.
    </p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-5">
    <% radii.each do |radius| %>
      <div class="space-y-2">
        <div class="h-20 border border-emphasized bg-neutral-subtle <%= radius[:step] %>"></div>
        <p class="font-mono text-sm text-default"><%= radius[:step] %></p>
        <ul class="font-mono text-xs text-muted">
          <% radius[:used_by].each do |path| %>
            <li><%= path.delete_prefix("components/") %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</section>
