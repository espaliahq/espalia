---
title: Career Growth Framework — Entity Relationships
---
classDiagram
    direction TB

    %% ══════════ PLATFORM ══════════

    class FrameworkTemplate {
        +uuid id
        +string name
        +text description
        +uuid author_tenant_id
        +string[] tags
        +jsonb snapshot
        No acts_as_tenant
    }

    %% ══════════ AUTH (Devise — Global) ══════════

    class User {
        +uuid id
        +string email
        +string encrypted_password
        +bool global_admin
        NOT tenant-scoped
        has_prefix_id :usr
    }

    class TenantUser {
        +uuid id
        +uuid tenant_id
        +uuid user_id
        +uuid person_id [nullable]
        +enum role [member, admin]
        acts_as_tenant :tenant
        has_prefix_id :tnu
    }

    %% ══════════ STATE-BASED ══════════

    class Tenant {
        +uuid id
        +string name
        +string slug
        +jsonb settings [theme]
    }

    class Person {
        +uuid id
        +uuid tenant_id
        +string email
        +jsonb name_translations
        +uuid manager_id
        acts_as_tenant :tenant
        has_prefix_id :per
    }

    %% ══════════ FRAMEWORK (ES projected state) ══════════

    class Framework {
        +uuid id
        +uuid tenant_id
        +string name
        +int current_published_version
        +bool draft_in_progress
        RES stream per framework
    }

    class RoleFamily {
        +uuid id
        +string name
    }

    class Role {
        +uuid id
        +string name
        +string code
        +enum track
    }

    class Level {
        +uuid id
        +int ordinal
        +string title
        +string code
    }

    class CapabilityCategory {
        +uuid id
        +string name
        +text description
    }

    class Capability {
        +uuid id
        +uuid stable_id
        +string name
        +enum status
    }

    class CapabilityRoleBinding {
        +uuid id
        +decimal weight
        +enum requirement_type
    }

    class BehaviouralExpectation {
        +uuid id
        +uuid stable_id
        +text description
        Canonical - RATED
    }

    class RoleIllustration {
        +uuid id
        +uuid stable_id
        +int ordinal
        +text description
        Clarifying - NOT rated
    }

    class FrameworkCollaborator {
        +uuid person_id
        +enum role
        +uuid scope_role_id
    }

    class SuggestedEdit {
        +uuid id
        +uuid suggestion_id
        +uuid author_id
        +enum target_entity_type
        +uuid target_entity_id
        +string field
        +text current_value
        +text suggested_value
        +enum status [pending, approved, rejected, withdrawn]
    }

    class FrameworkMigration {
        +uuid id
        +uuid from_stable_id
        +uuid to_stable_id
        +enum mapping_type
        +bool requires_reassessment
        +text reason
    }

    %% ══════════ PERSON DEV (ES projected state) ══════════

    class PersonDevelopmentStream {
        +uuid person_id
        +uuid framework_id
        RES stream per person+framework
    }

    class AssessmentState {
        Per capability: self/mgr/aligned
        acts_as_tenant :tenant
    }

    class EvidenceItem {
        +uuid id
        +enum source
        +enum evidence_type
        +text content
        +ExternalReference ext_ref
        acts_as_tenant :tenant
    }

    class GrowthPlanState {
        +text goal
        +enum goal_type
        +date target_date
        +enum status
        acts_as_tenant :tenant
    }

    %% ══════════ RELATIONSHIPS ══════════

    FrameworkTemplate ..> Framework : forked into

    User "1" --> "*" TenantUser : memberships
    Tenant "1" --> "*" TenantUser : members
    TenantUser "0..1" --> "0..1" Person : linked to

    Tenant "1" --> "*" Person : employs
    Tenant "1" --> "*" Framework : owns

    Person "*" --> "0..1" Person : reports to

    Framework "1" --> "*" RoleFamily
    Framework "1" --> "*" CapabilityCategory
    Framework "1" --> "*" FrameworkMigration
    Framework "1" --> "*" FrameworkCollaborator
    Framework "1" --> "*" SuggestedEdit

    RoleFamily "1" --> "*" Role
    Role "1" --> "*" Level

    CapabilityCategory "1" --> "*" Capability
    Capability "1" --> "*" CapabilityRoleBinding
    Role "1" --> "*" CapabilityRoleBinding

    Capability "1" --> "*" BehaviouralExpectation
    Level "1" --> "*" BehaviouralExpectation

    BehaviouralExpectation "1" --> "*" RoleIllustration
    Role "1" --> "*" RoleIllustration

    Person "1" --> "1" PersonDevelopmentStream
    PersonDevelopmentStream --> AssessmentState
    PersonDevelopmentStream --> EvidenceItem
    PersonDevelopmentStream --> GrowthPlanState
