#!/usr/bin/env node
// Regenerates every app-icon asset under public/ from the vector mark below.
//
//   npm install --no-save --prefix tmp/icon-build @resvg/resvg-js png-to-ico
//   NODE_PATH=tmp/icon-build/node_modules bin/build-icons
//
// The two paths are the source of truth (public/icon.svg is written from them).
// See docs/guidelines/app-icons.md for what each output is for.
// Mark bounds in the 1024 box: x 195–868, y 180–847 → centre (531.5, 513.5).
const { Resvg } = require("@resvg/resvg-js");
const pngToIcoMod = require("png-to-ico"); const pngToIco = pngToIcoMod.default || pngToIcoMod;
const fs = require("fs");
const path = require("path");
const out = path.join(__dirname, "..", "public") + "/";
const COLOR = "#32c8c8"; // Default --gos-brand / --gos-nav-surface in theme/roles.css (light)
const STEPS = "M223,847 H777 A28,28 0 0 0 805,819 V408 A28,28 0 0 0 777,380 H633 A28,28 0 0 0 605,408 V506 A14,14 0 0 1 591,520 H428 A28,28 0 0 0 400,548 V636 A14,14 0 0 1 386,650 H223 A28,28 0 0 0 195,678 V819 A28,28 0 0 0 223,847 Z";
const LEAF = "M688,400 V330 C688,235 765,180 868,180 C870,300 812,380 726,380 V400 Z";
const CX = 531.5, CY = 513.5;

function svg({ span, bg = null, semantic = false }) {
  const x = (CX - span / 2).toFixed(1), y = (CY - span / 2).toFixed(1);
  const a11y = semantic
    ? ` role="img" aria-labelledby="growthos-title growthos-desc"`
    : ` aria-hidden="true"`;
  const meta = semantic
    ? `\n  <title id="growthos-title">GrowthOS</title>\n  <desc id="growthos-desc">Three ascending steps with a leaf sprouting from the top step.</desc>`
    : "";
  const rect = bg ? `\n  <rect x="${x}" y="${y}" width="${span}" height="${span}" fill="${bg}"/>` : "";
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${x} ${y} ${span} ${span}"${a11y}>${meta}${rect}
  <g fill="${COLOR}">
    <path d="${STEPS}"/>
    <path d="${LEAF}"/>
  </g>
</svg>
`;
}
const png = (markup, size) =>
  new Resvg(markup, { fitTo: { mode: "width", value: size } }).render().asPng();
const write = (name, buf) => { fs.writeFileSync(out + name, buf); console.log(name, buf.length); };

// Favicon: tight crop (~4% padding) so 16/32 px spend their pixels on the mark.
const favicon = svg({ span: 730, semantic: true });
write("icon.svg", favicon);
pngToIco([16, 32, 48].map((s) => png(favicon, s)))
  .then((ico) => write("favicon.ico", ico))
  .catch((err) => { console.error("favicon.ico NOT written — public/ is now half-regenerated:", err); process.exitCode = 1; });

// PWA "any" icons: transparent, ~10% padding.
const any = svg({ span: 840 });
write("icon.png", png(any, 512));
write("icon-192.png", png(any, 192));

// PWA maskable: opaque, mark inside the 80% safe-zone circle. The mark's
// farthest point from the centre is the leaf tip, ~474 units out, so the
// tile's half-span × 0.8 must exceed that: 1200 → 480.
write("icon-maskable-512.png", png(svg({ span: 1200, bg: "#ffffff" }), 512));

// Apple touch icon: opaque (iOS paints black behind transparency), ~72% mark.
write("apple-touch-icon.png", png(svg({ span: 935, bg: "#ffffff" }), 180));
