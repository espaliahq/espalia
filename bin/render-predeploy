#!/usr/bin/env bash
set -o errexit

log() { echo "[predeploy $(date -u +%H:%M:%S)] $*"; }

# Ruby block-buffers stdout when it isn't a TTY, which hides multi-minute
# seed/rebuild progress from Render's log collector until the process exits.
# stdbuf overrides libc buffering on the child process so puts lines flush
# as they're written. Falls back to running unwrapped if stdbuf is missing.
rake() {
  if command -v stdbuf >/dev/null; then
    stdbuf -oL -eL bundle exec bin/rails "$@"
  else
    bundle exec bin/rails "$@"
  fi
}

# 1. Render provisions only the primary database. Solid Cache / Queue / Cable each
# want their own database on the same Postgres instance — create them here if
# they don't already exist, then let db:prepare run migrations across all four.

log "step 1: ensure solid_* databases exist"
for db in growth_os_production_cache growth_os_production_queue growth_os_production_cable; do
  exists=$(PGPASSWORD="$DB_PASSWORD" psql -h "$DB_HOST" -U "$DB_USERNAME" -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='$db'")
  if [ "$exists" != "1" ]; then
    log "  creating database $db"
    PGPASSWORD="$DB_PASSWORD" psql -h "$DB_HOST" -U "$DB_USERNAME" -d postgres -c "CREATE DATABASE \"$db\""
  else
    log "  $db already exists"
  fi
done
log "step 1: done"

# 2. Schema migrations across all four databases.
log "step 2: db:prepare (4 databases)"
rake db:prepare
log "step 2: done"

# 3. Optional inline projection rebuild — only when explicitly authorized for
#    this deploy. REBUILD_ON_DEPLOY is a comma-separated list of projection
#    names from `events:projections:list`. Runs the rebuild against the new
#    image BEFORE the verify gate, so a version bump can ship in one deploy.
#    Risk: rebuild duration becomes part of the predeploy window. For very
#    large rebuilds, use the two-stage path documented in the runbook.
#
#    A rebuild truncates the projection's live tables while the previous
#    release is still serving, so it only runs when the stamped version is
#    behind CODE_VERSION: a variable forgotten after its deploy stays inert
#    instead of blanking assessments for a minute on every deploy.
if [ -n "$REBUILD_ON_DEPLOY" ]; then
  log "step 3: REBUILD_ON_DEPLOY=$REBUILD_ON_DEPLOY"
  IFS=',' read -ra names <<< "$REBUILD_ON_DEPLOY"
  for name in "${names[@]}"; do
    name="${name// /}"  # strip whitespace
    [ -z "$name" ] && continue  # skip empty entries from stray commas
    log "  rebuild if stale: $name"
    rake "events:projections:rebuild_if_stale[$name]"
    log "  rebuild if stale: $name done"
  done
  log "step 3: done"
else
  log "step 3: REBUILD_ON_DEPLOY not set, skipping"
fi

# 4. Reset and stamp any never-rebuilt projection with no handled events in
#    the store, so a newly registered one deploys without REBUILD_ON_DEPLOY.
#    Then hard fail if any projection's persisted version differs from its
#    CODE_VERSION constant. This is the predeploy guard — see
#    `docs/runbooks/projection-rebuild.md` for the resolution flow. One rake
#    process runs both, so the app boots once.
log "step 4: events:projections:stamp_if_no_events, events:projections:verify"
rake events:projections:stamp_if_no_events events:projections:verify
log "step 4: done — predeploy complete"
