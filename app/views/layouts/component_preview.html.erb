<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>GrowthOS previews</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "tailwind" %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <%# The app's own page surface (Kit::PageLayout), so a dark preview isn't dark ink on white. %>
  <body class="min-h-screen bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 p-6">
    <%= render Components::Kit::IconSprite.new %>
    <%= yield %>
  </body>
</html>
