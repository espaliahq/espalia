<!DOCTYPE html>
<% theme_tenant = current_tenant if defined?(current_tenant) %>
<% overrides = respond_to?(:html_data_scheme) ? { theme: dev_theme_override, scheme: html_data_scheme }.compact : {} %>
<%# A tenant-less page (sign-in) names its own theme with content_for(:html_theme) %>
<% html_data = { theme: content_for(:html_theme).presence || theme_tenant&.theme_preset }.merge(overrides) %>
<html <%= tag.attributes(lang: I18n.locale, data: html_data) %>>
  <head>
    <title><%= [@page_title, (current_tenant&.name if defined?(current_tenant)), Rails.application.config.x.product_name].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Turbo keeps <html>'s attributes across a visit, so a page whose theme or scheme differs reloads %>
    <meta name="html-appearance" content="<%= html_data.values_at(:theme, :scheme).compact.join(" ") %>" data-turbo-track="reload">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= Rails.application.config.x.product_name %>">
    <% if content_for?(:theme_color) %>
      <%= yield :theme_color %>
    <% elsif html_data[:scheme] %>
      <meta name="theme-color" content="<%= Tenant.browser_theme_color(theme_tenant, html_data[:scheme].to_sym) %>">
    <% else %>
      <meta name="theme-color" content="<%= Tenant.browser_theme_color(theme_tenant, :light) %>" media="(prefers-color-scheme: light)">
      <meta name="theme-color" content="<%= Tenant.browser_theme_color(theme_tenant, :dark) %>" media="(prefers-color-scheme: dark)">
    <% end %>
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <% font_url = Tenant::PRESET_FONT_URLS.fetch(html_data[:theme]) { theme_tenant&.google_font_url } %>
    <% if font_url %>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="<%= font_url %>" rel="stylesheet" data-turbo-track="reload">
    <% end %>

    <%# App icon set — generated by bin/build-icons, see docs/guidelines/app-icons.md %>
    <link rel="icon" href="<%= app_icon_path("favicon.ico") %>" sizes="16x16 32x32 48x48">
    <link rel="icon" href="<%= app_icon_path("icon.svg") %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= app_icon_path("apple-touch-icon.png") %>">
    <link rel="manifest" href="<%= app_icon_path("manifest.json") %>">

    <%# Tailwind CSS compiled output %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# Application-specific styles %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# A Custom theme's --tenant-* values; theme/roles.css picks the light or dark one %>
    <% tenant_theme = theme_tenant&.theme_css_variables || {} %>
    <% if tenant_theme.any? %>
      <style id="tenant-theme" data-turbo-track="reload">
        :root { <%= tenant_theme.map { |k, v| "#{k}:#{v}" }.join('; ').html_safe %> }
      </style>
    <% end %>
  </head>

  <body>
    <%# Tenant-admin impersonation banner — sticky, on every page while active %>
    <% if respond_to?(:impersonating?) && impersonating? %>
      <%= render Components::Shell::ImpersonationBanner.new(name: impersonated_display_name) %>
    <% end %>

    <%# Devise pages handle flash inline — skip the toast to avoid duplication %>
    <% if !devise_controller? && (flash[:notice] || flash[:alert]) %>
      <%= render Components::Kit::Toast::Stack.new do %>
        <% if flash[:notice] %>
          <%= render Components::Kit::Toast.new(tone: :success) do %><span><%= flash[:notice] %></span><% end %>
        <% end %>
        <% if flash[:alert] %>
          <%= render Components::Kit::Toast.new(tone: :danger) do %><span><%= flash[:alert] %></span><% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= yield %>
  </body>
</html>
