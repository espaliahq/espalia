<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= [@page_title, (current_tenant&.name if defined?(current_tenant)), "GrowthOS"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="GrowthOS">
    <% theme_tenant = current_tenant if defined?(current_tenant) %>
    <meta name="theme-color" content="<%= Tenant.browser_theme_color(theme_tenant, :light) %>" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="<%= Tenant.browser_theme_color(theme_tenant, :dark) %>" media="(prefers-color-scheme: dark)">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <% if defined?(current_tenant) && current_tenant&.google_font_url %>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="<%= current_tenant.google_font_url %>" rel="stylesheet" data-turbo-track="reload">
    <% end %>

    <%# App icon set — generated by bin/build-icons, see docs/guidelines/app-icons.md %>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">

    <%# Tailwind CSS compiled output %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# Application-specific styles %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <% if defined?(current_tenant) && current_tenant %>
      <% light = current_tenant.theme_css_variables_light %>
      <% dark = current_tenant.theme_css_variables_dark %>
      <% if light.any? || dark.any? %>
        <style id="tenant-theme" data-turbo-track="reload">
          <% if light.any? %>
            :root { <%= light.map { |k, v| "#{k}:#{v}" }.join('; ').html_safe %> }
          <% end %>
          <% if dark.any? %>
            @media (prefers-color-scheme: dark) {
              :root { <%= dark.map { |k, v| "#{k}:#{v}" }.join('; ').html_safe %> }
            }
          <% end %>
        </style>
      <% end %>
    <% end %>
  </head>

  <body>
    <%# Tenant-admin impersonation banner — sticky, on every page while active %>
    <% if respond_to?(:impersonating?) && impersonating? %>
      <%= render Components::Kit::ImpersonationBanner.new(name: impersonated_display_name) %>
    <% end %>

    <%# Devise pages handle flash inline — skip the toast to avoid duplication %>
    <% if !devise_controller? && (flash[:notice] || flash[:alert]) %>
      <div class="fixed top-4 right-4 z-50 flex flex-col gap-2">
        <% if flash[:notice] %>
          <div class="flex items-start gap-3 rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-800 shadow-sm"
               role="status"
               data-controller="flash"
               data-flash-delay-value="5000">
            <span class="flex-1"><%= flash[:notice] %></span>
            <button type="button"
                    class="text-green-700 hover:text-green-900 focus:outline-hidden focus:ring-2 focus:ring-green-400 rounded cursor-pointer"
                    aria-label="Dismiss notification"
                    data-action="flash#dismiss">×</button>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="flex items-start gap-3 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800 shadow-sm"
               role="alert"
               data-controller="flash"
               data-flash-delay-value="7000">
            <span class="flex-1"><%= flash[:alert] %></span>
            <button type="button"
                    class="text-red-700 hover:text-red-900 focus:outline-hidden focus:ring-2 focus:ring-red-400 rounded cursor-pointer"
                    aria-label="Dismiss notification"
                    data-action="flash#dismiss">×</button>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
